# .env of the observability stack on the server: copy to .env in its folder (the repository secret
# OBSERVABILITY_PATH) and fill in. It is not in Git and the deploy never touches it.

# The stack and its connection to Caddy (the deploy copies deploy/observability-edge.yaml there as edge.yaml).
COMPOSE_FILE=compose.yaml:edge.yaml

# For a 2 GB server: keep every trace with an error or slower than 500 ms and 10 % of the others, and only WARN and
# above of the logs. Metrics and the dashboard stay complete.
COLLECTOR_KEEP=some

# Grafana is reachable from the internet (https://grafana.stefan-hoffmann.de), so: no anonymous viewing, and a real
# admin password. Grafana only takes the password on its very first start; to change it later:
#   docker compose exec grafana grafana cli admin reset-admin-password '…'
GRAFANA_ANONYMOUS=false
GRAFANA_ADMIN_PASSWORD=
GRAFANA_ROOT_URL=https://grafana.stefan-hoffmann.de

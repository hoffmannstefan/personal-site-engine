# .env of the production site on the server: copy to .env in its folder (the repository secret DEPLOY_PATH) and fill
# in. It is not in Git and the deploy never touches it.

# Every docker compose command in this folder uses these files: the site, the connection to the observability stack,
# the connection to Caddy.
COMPOSE_FILE=compose.yaml:observability/connect-app.yaml:deploy/site-edge.yaml

# The frontend's name for Caddy (site-production-frontend), and its port, only on the server itself (for checks via
# SSH, e.g. curl localhost:18080); visitors come through Caddy.
SITE_NAME=site-production
SITE_PORT=127.0.0.1:18080

# Shown in the telemetry; the deploy sets it as well.
DEPLOYMENT_ENVIRONMENT=production

# Enables deleting comments (curl -X DELETE -H 'X-Admin-Token: …' …). A long random value: openssl rand -hex 32
COMMENTS_ADMIN_TOKEN=

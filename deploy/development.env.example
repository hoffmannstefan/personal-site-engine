# .env of the development site on the server: copy to .env in its folder (the secret DEPLOY_PATH of the GitHub
# environment "development") and fill in. It is not in Git and the deploy never touches it.

COMPOSE_FILE=compose.yaml:observability/connect-app.yaml:deploy/site-edge.yaml

# The frontend's name for Caddy (site-development-frontend), and its port, only on the server itself.
SITE_NAME=site-development
SITE_PORT=127.0.0.1:18081

DEPLOYMENT_ENVIRONMENT=development

# A token of its own, not the one of production.
COMMENTS_ADMIN_TOKEN=
